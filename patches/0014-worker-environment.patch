@@ -21,6 +21,56 @@ using node::UncheckedMalloc;
 
 class UtilTest : public EnvironmentTestFixture {};
 
+TEST_F(UtilTest, CloneEnvironmentWithRemovedVariable) {
+  class VanishingEnvStore final : public node::KVStore {
+   public:
+    v8::MaybeLocal<v8::String> Get(
+        v8::Isolate* isolate, v8::Local<v8::String> key) const override {
+      return store_->Get(isolate, key);
+    }
+    std::optional<std::string> Get(const char* key) const override {
+      return store_->Get(key);
+    }
+    void Set(v8::Isolate* isolate,
+             v8::Local<v8::String> key,
+             v8::Local<v8::String> value) override {
+      store_->Set(isolate, key, value);
+    }
+    int32_t Query(v8::Isolate* isolate,
+                  v8::Local<v8::String> key) const override {
+      return store_->Query(isolate, key);
+    }
+    int32_t Query(const char* key) const override {
+      return store_->Query(key);
+    }
+    void Delete(v8::Isolate* isolate, v8::Local<v8::String> key) override {
+      store_->Delete(isolate, key);
+    }
+    v8::Local<v8::Array> Enumerate(v8::Isolate* isolate) const override {
+      auto keys = store_->Enumerate(isolate);
+      store_->Delete(isolate, node::OneByteString(isolate, "removed"));
+      return keys;
+    }
+
+   private:
+    std::shared_ptr<node::KVStore> store_ = node::KVStore::CreateMapKVStore();
+  } store;
+
+  const v8::HandleScope handle_scope(isolate_);
+  auto context = v8::Context::New(isolate_);
+  const v8::Context::Scope context_scope(context);
+  store.Set(isolate_, node::OneByteString(isolate_, "kept"),
+            node::OneByteString(isolate_, "value"));
+  store.Set(isolate_, node::OneByteString(isolate_, "empty"),
+            node::OneByteString(isolate_, ""));
+  store.Set(isolate_, node::OneByteString(isolate_, "removed"),
+            node::OneByteString(isolate_, "gone"));
+  auto copy = store.Clone(isolate_);
+  EXPECT_EQ(copy->Get("kept"), std::make_optional(std::string("value")));
+  EXPECT_EQ(copy->Get("empty"), std::make_optional(std::string("")));
+  EXPECT_FALSE(copy->Get("removed").has_value());
+}
